{
  "uid": "zipsai-load-test",
  "title": "Zipsai Load Test",
  "schemaVersion": 41,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "API별 RPS",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (method, uri) (rate(http_server_requests_milliseconds_count{uri!~\"/api/actuator.*\"}[30s]))",
          "legendFormat": "{{method}} {{uri}}",
          "interval": "5s"
        }
      ],
      "id": 1,
      "interval": "5s",
      "maxDataPoints": 2000
    },
    {
      "type": "timeseries",
      "title": "API별 p95 응답 시간",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_milliseconds_bucket{uri!~\"/api/actuator.*\"}[30s])))",
          "legendFormat": "{{method}} {{uri}}",
          "interval": "5s"
        }
      ],
      "id": 2,
      "interval": "5s",
      "maxDataPoints": 2000
    },
    {
      "type": "timeseries",
      "title": "5xx 오류율",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(http_server_requests_milliseconds_count{uri!~\"/api/actuator.*\", status=~\"5..\"}[30s])) / sum(rate(http_server_requests_milliseconds_count{uri!~\"/api/actuator.*\"}[30s]))",
          "legendFormat": "5xx",
          "interval": "5s"
        }
      ],
      "id": 3,
      "interval": "5s",
      "maxDataPoints": 2000
    },
    {
      "type": "timeseries",
