          "interval": "5s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "clamp_min(sum(tomcat_connections_current) - sum(http_server_requests_active_milliseconds_count{uri!~\"/api/actuator.*\"}), 0)",
